# Copy to .env.local, then restart `npm run dev`.

# Option A — NVIDIA NIM (OpenAI-compatible)
# NVIDIA_API_KEY=nvapi-...
# HERA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Thinking is enabled by default; set to 0 to disable it.
# HERA_THINKING=1

# Option B — Anthropic directly
ANTHROPIC_API_KEY=
# HERA_MODEL=claude-sonnet-5-5

# Option C — Vercel AI Gateway (any provider): use a "provider/model" id
# AI_GATEWAY_API_KEY=
# HERA_MODEL=anthropic/claude-sonnet-5-5

# Optional: where the SQLite file lives (default ./data/hera.db)
# HERA_DB_PATH=
